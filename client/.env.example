# ==============================================================================
# CartNOW Client (Storefront) Environment Configuration (Template)
# Copy this file to '.env' and populate with your frontend configuration.
# ==============================================================================

# Backend API Base URL
VITE_BACKEND_URL=http://localhost:4000

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Logo.dev Brand/Logo API Publishable Key (https://logo.dev)
VITE_LOGO_DEV_KEY=your_publishable_key
