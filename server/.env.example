# ==============================================================================
# CartNOW Server Environment Configuration (Template)
# Copy this file to '.env' and populate with your secure credentials.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (MongoDB)
# Example: mongodb://localhost:27017 or mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# JWT Authentication Secret (Use a secure high-entropy random string)
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# Admin Initial Credentials
ADMIN_EMAIL=admin@cartnow.com
ADMIN_PASSWORD=change_this_admin_password_in_production

# Cloudinary Media Storage
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# Payment Gateways (Test credentials for development)
# Stripe: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Razorpay: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=rzp_secret_your_razorpay_key_secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI & External Vision Services
GEMINI_API_KEY=your_gemini_api_key
REPLICATE_API_TOKEN=your_replicate_api_token
REMOVE_BG=your_remove_bg_api_key

# Redis Cache & BullMQ Queue Connection
REDIS_URL=redis://127.0.0.1:6379

# Python AI Try-On Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000
